# ==============================================
# DermaAsist - Environment Configuration Template
# ==============================================

# --- Server Configuration ---
PORT=3001
NODE_ENV=development

# Database (Default: local SQLite dev database)
DATABASE_URL="file:./dev.db"
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dermacon-in

# Authentication & Security
JWT_SECRET=dermaasist-super-secret-jwt-key-change-in-production-2024
JWT_REFRESH_SECRET=dermaasist-refresh-secret-key-change-in-production-2024
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Model Service Provider ('mock' | 'fastapi' | 'huggingface' | 'external_api')
AI_PROVIDER=mock

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS & Rate Limiting
ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Frontend (Client) Configuration ---
# VITE_API_URL=http://localhost:3001/api
# VITE_DEMO_MODE=true
